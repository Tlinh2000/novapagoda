{
  "name": "nova-pagoda",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Nova Pagoda — chùa Việt 3D multiplayer · Three.js + Socket.io",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node scripts/check-assets.mjs",
    "test": "node --test tests/*.test.js",
    "generate:avatar": "node scripts/generate-avatar.mjs",
    "generate:assets": "node scripts/generate-avatar.mjs && node scripts/generate-statue.mjs",
    "check": "node scripts/check-assets.mjs",
    "generate:statue": "node scripts/generate-statue.mjs"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "mongodb": "^6.20.0",
    "multer": "^2.0.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.1",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.1"
  }
}
